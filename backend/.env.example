# Copy this file to .env. Never commit credentials.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/hustlehub
JWT_SECRET=REPLACE_WITH_A_SEPARATE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
FORCE_HTTPS=false
REFRESH_COOKIE_SAMESITE=lax
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15
AUTH_RATE_LIMIT_MAX=20
GENERAL_RATE_LIMIT_MAX=300
BOOKING_RATE_LIMIT_MAX=20

# Better Stack -> Sources -> Create source -> JavaScript/Node.js
LOGTAIL_SOURCE_TOKEN=
LOGTAIL_INGESTING_HOST=
LOG_LEVEL=info

# For manual initial admin seeding only (do not commit real values)
ADMIN_EMAIL=
ADMIN_PASSWORD=
