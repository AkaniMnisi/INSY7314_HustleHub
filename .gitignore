# ============================================================
# Frontend .gitignore
# ============================================================

# Dependency directories
node_modules/
jspm_packages/

# dotenv environment variable files
.env
.env.*
!.env.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock
api.pid

# Coverage
coverage
*.lcov
.nyc_output

# Build outputs
dist/
dist
build/Release
out
.output
.next
.nuxt

# Caches and tooling
.cache
.parcel-cache
.eslintcache
.stylelintcache
.npm
.node_repl_history
.grunt
lib-cov
.lock-wscript
bower_components
web_modules/
*.tsbuildinfo

# Vite
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Astro
.astro/

# Turbo
.turbo

# Framework-specific
.svelte-kit/
.vuepress/dist
**/.vitepress/dist
**/.vitepress/cache
.docusaurus
.serverless/
.fusebox/
.dynamodb/
.firebase/
.tern-port

# Packaging
*.tgz
.yarn-integrity

# pnpm
.pnpm-store

# yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# VS Code test extensions
.vscode-test

# OS
.DS_Store